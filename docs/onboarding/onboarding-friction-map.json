    { "route": "/g/:uuid", "texte_actuel": "Galerie introuvable / Vérifiez le lien.", "statut": "OK", "recommendation": "garder + lien contact" },
    { "route": "template portfolio", "texte_actuel": "Aucune photo disponible pour le moment.", "statut": "OK", "recommendation": "garder" }
