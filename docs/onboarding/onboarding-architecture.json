{
  "schema_version": "1.0.0",
  "project": {
    "name": "VANDA STUDIO",
    "description": "Plateforme SaaS permettant à chaque photographe de créer, gérer et monétiser son propre studio en ligne : builder de site vitrine, galeries client (livraison photos), facturation, abonnement (paiement Maketou).",
    "primary_customer": "Photographes professionnels",
    "secondary_users": ["Clients finaux des photographes", "Super-admin plateforme"],
    "languages": ["fr"],
    "currency": "FCFA",
    "free_trial": "30 jours sans carte bancaire (promesse marketing)",
    "domain_structure": {
      "main": "vanda-studio.org (marketing)",
      "admin": "app.vanda-studio.org (application photographe)",
      "api": "api.vanda-studio.org (API REST)",
      "photographer_subdomain": "{slug}.vanda-studio.org (site vitrine généré)"
    }
  },
  "codebase": {
    "backend": {
      "framework": "Laravel 11/12 (PHP 8.3)",
      "auth": "Sanctum tokens",
      "models": ["User", "Gallery", "Photo", "Like", "Invoice", "InvoiceItem", "SiteConfig", "SubscriptionPlan", "UserSubscription"],
      "middleware": ["EnsureUserIsActive (alias active)", "SuperAdminMiddleware (alias superadmin)"],
      "payment": "MaketouService (cart checkout + webhook)",
      "onboarding_state_backend": "Aucun état d'onboarding côté backend. Seul signal : has_site (siteConfigs()->exists()) renvoyé au login."
    },
    "frontend": {
      "framework": "React 18/19 + TypeScript + Vite",
      "ui": "MUI + shadcn/ui (Radix) + sonner + framer-motion",
      "builds": ["dist-public (site public)", "dist-admin (application admin)"],
      "routing_admin": ["/auth/login", "/auth/register", "/admin/dashboard", "/admin/new-delivery", "/admin/gallery/:uuid", "/admin/invoices", "/admin/invoices/new", "/admin/site-builder", "/superadmin/*"],
      "routing_public": ["/", "/pricing", "/g/:uuid", "/:slug"],
      "state": "localStorage (auth_token, user, selectedPlan, vanda_current_step, vanda_has_built_site, vanda_draft_invoice)",
      "analytics": "Aucun SDK analytics présent",
      "email": "Aucune infrastructure email frontend ; backend Laravel MAIL configuré mais aucun Mailable/queued job",
      "onboarding_ui_existant": "Builder 10 étapes avec WelcomeStep ; composant ui/empty.tsx inutilisé"
    }
  },
