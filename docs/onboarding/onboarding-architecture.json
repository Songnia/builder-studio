  "frictions": [
    { "id": "friction-signup-redirect", "type": "dead_end", "severity": "high", "route": "/auth/register", "persona_ids": ["persona-photographer-new"], "problem": "SignUp navigue vers /admin/dashboard (vide) alors que Login envoie les nouveaux utilisateurs (has_site=false) vers /admin/site-builder. Incohérence : l'inscrit voit un dashboard vide sans CTA.", "recommended_mechanism": "redirect_to_builder", "evidence": ["SignUp.tsx navigate('/admin/dashboard')", "Login.tsx navigate('/admin/site-builder')"] },
    { "id": "friction-empty-dashboard", "type": "empty_state", "severity": "high", "route": "/admin/dashboard", "persona_ids": ["persona-photographer-new"], "problem": "Dashboard vide ('Aucune livraison trouvée.') sans CTA ni orientation vers le builder, la facturation ou l'abonnement.", "recommended_mechanism": "onboarding_checklist", "evidence": ["AdminDashboard.tsx table vide", "Empty non branché"] },
    { "id": "friction-missing-routes", "type": "dead_end", "severity": "high", "route": "/admin/subscription, /admin/profile", "persona_ids": ["persona-photographer-new", "persona-photographer-pro"], "problem": "Les routes /admin/subscription et /admin/profile sont déclarées dans App.tsx mais ABSENTES de AppAdmin.tsx : UpgradeDialog navigue vers /admin/subscription → 404. Les liens Sidebar sont désactivés ('Bientôt disponible').", "recommended_mechanism": "fix_routes", "evidence": ["AppAdmin.tsx", "UpgradeDialog navigate('/admin/subscription')"] },
    { "id": "friction-publish-gating", "type": "premature_upsell", "severity": "medium", "route": "/admin/site-builder", "persona_ids": ["persona-photographer-new"], "problem": "La publication est gated par UpgradeDialog (feature=publish) alors que le backend accepte is_published=true au store ; les limites de plan sont cosmétiques (Infinity dans usePlanLimits). Message contradictoire pour l'utilisateur.", "recommended_mechanism": "clarify_publish_policy", "evidence": ["PreviewStep.tsx UpgradeDialog publish", "usePlanLimits.ts Infinity", "SiteConfigController store default true"] },
    { "id": "friction-no-onboarding", "type": "no_contextual_guidance", "severity": "high", "route": "toutes (admin)", "persona_ids": ["persona-photographer-new"], "problem": "Aucun mécanisme d'onboarding : pas de welcome modal, checklist, tour, tooltips, ni analytics. La seule brique est WelcomeStep du builder.", "recommended_mechanism": "welcome_modal + checklist", "evidence": ["aucun SDK", "aucun composant onboarding"] },
    { "id": "friction-selected-plan-lost", "type": "long_setup", "severity": "medium", "route": "/auth/register", "persona_ids": ["persona-photographer-new"], "problem": "Le plan choisi sur Landing/Pricing (localStorage.selectedPlan) est supprimé à l'inscription : l'intention d'achat est perdue et l'abonnement ne démarre pas.", "recommended_mechanism": "preserve_plan_intent", "evidence": ["SignUp.tsx removeItem('selectedPlan')"] },
    { "id": "friction-navbar-subscription", "type": "dead_end", "severity": "medium", "route": "AdminNavbar dropdown", "persona_ids": ["persona-photographer-active"], "problem": "Le menu 'Mon abonnement' du dropdown profile pointe vers /pricing (page publique marketing) au lieu de /admin/subscription.", "recommended_mechanism": "fix_link", "evidence": ["AdminNavbar.tsx"] },
    { "id": "friction-client-share-stub", "type": "dead_end", "severity": "low", "route": "/g/:uuid", "persona_ids": ["persona-client"], "problem": "Le bouton 'Envoyer' la sélection de la galerie client est un stub (simple snackbar), aucune action réelle.", "recommended_mechanism": "whatsapp_or_email", "evidence": ["ClientGalleryView handleSendSelection"] },
    { "id": "friction-cart-unmounted", "type": "dead_end", "severity": "low", "route": "template shop", "persona_ids": ["persona-client"], "problem": "Le CartDrawer n'est monté nulle part : le panier 'Commander' du shop est non fonctionnel.", "recommended_mechanism": "fix_cart", "evidence": ["CartDrawer.tsx non importé"] },
    { "id": "friction-gallery-status", "type": "feature_with_no_context", "severity": "low", "route": "/api/admin/galleries", "persona_ids": ["persona-photographer-active"], "problem": "Le statut gallery (draft/published/archived) n'est jamais transitionné par l'API : 'draft' permanent, aucune notion de 'livrée'.", "recommended_mechanism": "add_status_transitions", "evidence": ["GalleryController"] },
    { "id": "friction-builder-step-count", "type": "duplicate_setup_step", "severity": "low", "route": "/admin/site-builder", "persona_ids": ["persona-photographer-new"], "problem": "TOTAL_STEPS=9 dans useBuilder vs 10 composants d'étapes : la progression affichée est fausse.", "recommended_mechanism": "fix_step_count", "evidence": ["useBuilder.ts TOTAL_STEPS=9"] },
    { "id": "friction-no-email-verification", "type": "unnecessary_permission", "severity": "medium", "route": "auth", "persona_ids": ["persona-photographer-new"], "problem": "Le réglage require_email_verification existe côté superadmin mais aucune vérification n'est implémentée côté frontend (pas d'écran verify, pas de resend).", "recommended_mechanism": "defer_or_implement", "evidence": ["SuperAdminSettings", "Login/SignUp sans verify"] },
    { "id": "friction-profile-schema", "type": "feature_with_no_context", "severity": "low", "route": "/admin/profile", "persona_ids": ["persona-photographer-active"], "problem": "phone/bio/avatar référencés dans le code mais absents du schéma users et du fillable : profil incomplet.", "recommended_mechanism": "extend_schema", "evidence": ["User.php fillable", "migrations"] }
