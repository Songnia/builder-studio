# =====================================================
# VANDA STUDIO — .gitignore
# =====================================================

# Local agent tooling & internal reports (never public)
.agents/
.audit/
.onboarding/
.codex/
backup/
/releases/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
!**/.env.example
!**/.env.production.example
*.pem
*.key
*.p12
*.pfx
*.p8
id_rsa
id_rsa.pub
ssh.txt
ssh.txt.pub
.~lock.*#

# Backend (Laravel)
/backend/vendor/
/backend/node_modules/
/backend/.phpunit.result.cache
/backend/.phpunit.cache/
/backend/Homestead.json
/backend/Homestead.yaml
/backend/npm-debug.log
/backend/yarn-error.log
/backend/.idea
/backend/.vscode
/backend/storage/*.key
/backend/storage/app/*
!/backend/storage/app/.gitignore
/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/testing/*
!/backend/storage/framework/testing/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore

# Backend archives / backups
/backend/*.zip
/backend/*.log
/backend/server.log
/backend/app.zip
/backend/bootstrap.zip
/backend/config.zip
/backend/database.zip
/backend/resources.zip
/backend/routes.zip
/backend/storage.zip

# Frontend (React/Vite)
/frontend/node_modules/
/frontend/dist/
/frontend/dist-*
/frontend/dist-ssr/
/frontend/dev-dist/
/frontend/.vite/
/frontend/.env.production
/frontend/.env.development
/frontend/.env.local
/frontend/.env
/frontend/coverage/
/frontend/.nyc_output/
/frontend/.cache/
/frontend/build/
/frontend/.DS_Store
/frontend/*.log
/frontend/.turbo
/frontend/imports_list.txt

# Stale / duplicated snapshots
/VANDA_UPDATE_IMAGES_FIX/
/frontProduction2026/
/startjobs-main/
/frontend/new vertion of landing page/
/screenshortApplicationvanda/
/backend/public/assets/

# Superseded documentation
/docs/old/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
*.lcov
.nyc_output/
# Local MySQL test runner (CI uses sqlite :memory: via phpunit.xml)
/backend/phpunit.mysql.xml

# Temporary files
*.tmp
*.temp
.cache/
tmp/
temp/

# Databases
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.sql
*.dump
*.backup
*.bak
*.orig

# Uploaded files (configurable - comment out if you want to track uploads)
/backend/storage/app/public/uploads/*
/backend/public/uploads/*
/backend/public/storage/*

# Personal notes
TODO.md
NOTES.md
