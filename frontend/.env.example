# VANDA STUDIO — Frontend environment variables
# Copy this file to `.env` and adjust the values for your environment.

# Optional in local development: requests use /api and are proxied by Vite.
# Set this only when the API is hosted elsewhere.
VITE_API_URL=

# Laravel server targeted by the Vite development proxy.
VITE_DEV_API_TARGET=http://localhost:8000

# Public site URL (the public Vanda Studio site)
VITE_PUBLIC_DOMAIN=

# Admin application URL (used for links in the public site)
VITE_ADMIN_URL=http://localhost:5173

# App mode: "public" or "admin" (used by the dual-build setup)
VITE_APP_MODE=public
